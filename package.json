{
  "name": "obsidian-export-studio",
  "version": "0.1.1",
  "description": "Export notes to PDF and HTML with clickable links between them, a note picker, cover, contents and page numbers. Ported from Starnote.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node --test tests/"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "export",
    "html"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  },
  "author": "encomjp"
}
